# 复制为 .env 后填入。.env 已在 .gitignore 中，不会入库。

# 阿里云百炼（DashScope），OpenAI 兼容端点
DASHSCOPE_API_KEY= 

# 可选：DeepSeek 作为备选模型
DEEPSEEK_API_KEY= 

# Governed runtime (SDK, no vendor key required)
# KEEL_ENABLED=1
# KEEL_ENV=staging
# KEEL_MANIFEST=agent.yaml
# KEEL_ASKDB_TOKEN=<per-agent internal credential>
# KEEL_BRIDGE_TOKEN=<same AskDB credential, used by eval jobs>
# KEEL_LLM_BASE_URL=<model gateway root>
# KEEL_LLM_KEY=<AskDB virtual key>
# KEEL_AUDIT_URL=<audit service root>
# KEEL_AUDIT_TOKEN=<audit service credential>
# KEEL_AUDIT_SPOOL_PATH=<durable spool path>
# KEEL_TRACE_BUFFER_PATH=<durable trace buffer path>
# LANGFUSE_HOST=https://jp.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=<platform project public key>
# LANGFUSE_SECRET_KEY=<platform project secret key>
