# 环境与密钥 —— 绝不入库
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 运行时产物
data/*.duckdb
data/*.duckdb.wal
# 审计日志与检查点含真实问题、生成的 SQL 与查询结果行 —— 一律不入库。
# 只写 audit.jsonl / checkpoints.sqlite 会漏掉 -ragforge / -ragforge-prod
# 这些按数据源命名的变体，实际已因此泄露过一次。
data/audit*.jsonl
data/checkpoints*.sqlite
data/checkpoints*.sqlite-shm
data/checkpoints*.sqlite-wal
.chroma/

# 编辑器与系统
.idea/
.vscode/
.DS_Store

# 测试产物
.coverage
.coverage.*
coverage.xml
htmlcov/

# 向量索引
.chroma/
evals/*.json
# 评测结果**入库**：§6 把评测列为本项目主要产出之一，README 引用的每个
# 数字都该能在仓库里查到出处，clone 下来评测页也才有东西可显示。
# 结果文件只含逐题通过与否、失败原因、trace_id、耗时与成本，**不含任何数据行**。
evals/results/*
!evals/results/*.json
