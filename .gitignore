# 环境与密钥 —— 绝不入库
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 运行时产物
data/*.duckdb
data/*.duckdb.wal
# 审计日志与检查点含真实问题、生成的 SQL 与查询结果行 —— 一律不入库。
# 只写 audit.jsonl / checkpoints.sqlite 会漏掉 -ragforge / -ragforge-prod
# 这些按数据源命名的变体，实际已因此泄露过一次。
data/audit*.jsonl
data/checkpoints*.sqlite
data/checkpoints*.sqlite-shm
data/checkpoints*.sqlite-wal
# 通配而不是精确名：配额文件也按数据源命名（audit-ragforge-quota.json、
# audit-ragforge-prod-quota.json…），只写 audit-quota.json 会漏掉这些变体。
data/audit*quota.json
# 同一批产物在 var/ 下也有一份，而且**那才是线上真正在写的位置** ——
# 对外实例的 audit_log 指向 var/（k8s 在此挂持久卷，见 public.yaml 的说明）。
# 上面那几条只覆盖了 data/，日志搬家时规则没跟着搬，于是同一次泄露又发生了一遍：
# 六个 commit 里 var/audit-public.jsonl 一直躺在版本库里，存的是用户问过的问题原文。
# 加规则的同时把已跟踪的那几个 git rm --cached 掉了。
var/audit*.jsonl
var/checkpoints*.sqlite
var/checkpoints*.sqlite-shm
var/checkpoints*.sqlite-wal
var/*.json
.chroma/

# 编辑器与系统
.idea/
.vscode/
.DS_Store

# 测试产物
.coverage
.coverage.*
coverage.xml
htmlcov/

# 向量索引
.chroma/
evals/*.json
# 评测结果**入库**：§6 把评测列为本项目主要产出之一，README 引用的每个
# 数字都该能在仓库里查到出处，clone 下来评测页也才有东西可显示。
# 结果文件只含逐题通过与否、失败原因、trace_id、耗时与成本，**不含任何数据行**。
evals/results/*
!evals/results/*.json
